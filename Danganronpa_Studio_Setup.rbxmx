        bgBin = "bgd_010.bin",
        charBin = "sayaka_maizono_00.bin",
    },
    {
        speaker = "Makoto Naegi",
        color = Color3.fromRGB(46, 204, 113),
        text = "Y-Yeah, that's me! Sayaka Maizono... The <CLT 3>Ultimate Pop Sensation<CLT>! You remember me?!",
        bgBin = "bgd_010.bin",
