        charBin = "byakuya_togami_00.bin",
    },
    {
        speaker = "Monokuma",
        color = Color3.fromRGB(235, 47, 6),
        text = "<CLT 1>Upupupu~! Mic test, mic test! Is everyone in the gym? Let the killing school life begin!<CLT>",
        bgBin = "bgd_014.bin",
        charBin = "monokuma_00.bin",
        flash = true,
        shake = true,
    },
}

-- 9. HTTP Raw Pixel Streaming to EditableImage
local RAW_BASE_URL = "https://raw.githubusercontent.com/Deadstillplays/DageStanRope/main/pixels"
local LOCAL_BASE_URL = "http://localhost:8089/pixels"
local pixelCache = {} :: { [string]: buffer }

local function loadPixelBuffer(subPath: string): buffer?
    if pixelCache[subPath] then
        return pixelCache[subPath]
    end

    local endpoints = {
        string.format("%s/%s", RAW_BASE_URL, subPath),
        string.format("%s/%s", LOCAL_BASE_URL, subPath),
    }

    for _, url in ipairs(endpoints) do
        local ok, data = pcall(function()
            return HttpService:GetAsync(url)
        end)
        if ok and data and #data > 1000 then
            local buf = buffer.fromstring(data)
            pixelCache[subPath] = buf
            return buf
        end
    end
    return nil
end

-- Draw Procedural Backdrop if HTTP is not enabled yet
local function drawProceduralBackdrop(bgName: string)
    if not bgEditable then return end
    pcall(function()
        -- Cool dark slate floor & grid
        bgEditable:DrawRectangle(Vector2.zero, Vector2.new(480, 272), Color3.fromRGB(22, 18, 28), 0, Enum.ImageCombineType.Overwrite)
        -- Wall border
        bgEditable:DrawRectangle(Vector2.new(0, 0), Vector2.new(480, 160), Color3.fromRGB(36, 28, 44), 0, Enum.ImageCombineType.Overwrite)
        -- Neon accent line
        bgEditable:DrawRectangle(Vector2.new(0, 158), Vector2.new(480, 4), Color3.fromRGB(255, 42, 109), 0, Enum.ImageCombineType.Overwrite)
    end)
end

-- 10. Engine Step Execution
local currentStepIndex = 1
local isTyping = false
local isAuto = false
local isSkip = false

local function showStep(idx: number)
    if idx > #STORY_SCRIPT then idx = 1 end
    currentStepIndex = idx
    local step = STORY_SCRIPT[idx]

    -- 1. Speaker
    speakerLabel.Text = step.speaker
    badgeStroke.Color = step.color or Color3.fromRGB(46, 204, 113)

    -- 2. Background Stream to EditableImage
    if step.bgBin then
        task.spawn(function()
            local buf = loadPixelBuffer("backgrounds/" .. step.bgBin)
            if buf and bgEditable then
                pcall(function()
                    bgEditable:WritePixelsBuffer(Vector2.zero, Vector2.new(480, 272), buf)
                end)
            else
                drawProceduralBackdrop(step.bgBin)
            end
        end)
    end

    -- 3. Character Stream to EditableImage
    if step.charBin then
        charCanvasLabel.Visible = true
        task.spawn(function()
            local buf = loadPixelBuffer("characters/" .. step.charBin)
            if buf and charEditable then
                pcall(function()
                    charEditable:WritePixelsBuffer(Vector2.zero, Vector2.new(480, 280), buf)
                end)
            end
        end)
    else
        charCanvasLabel.Visible = false
    end

    -- 4. Effects
    if step.flash then screenFlash(Color3.fromRGB(255, 255, 255)) end
    if step.shake then screenShake() end

    -- 5. Typewriter Effect
    isTyping = true
    nextArrow.Visible = false
    local formatted = formatRichText(step.text)
    local plain = stripTags(formatted)
    local totalChars = #plain

    if isSkip then
        dialogueLabel.Text = formatted
        isTyping = false
        nextArrow.Visible = true
        task.wait(0.12)
        showStep(currentStepIndex + 1)
        return
    end

    task.spawn(function()
        local typeSpeed = 0.02
        local curLen = 0

        while curLen < totalChars and isTyping do
            curLen += 1
            dialogueLabel.Text = string.sub(plain, 1, curLen)
            if curLen % 4 == 0 then playClick() end
            task.wait(typeSpeed)
        end

        isTyping = false
        dialogueLabel.Text = formatted
        nextArrow.Visible = true

        if isAuto then
            task.wait(1.8)
            if isAuto and not isTyping then
                showStep(currentStepIndex + 1)
            end
        end
    end)
end

local function advance()
    if isTyping then
        isTyping = false
    else
        showStep(currentStepIndex + 1)
    end
end

-- 11. Buttons & Controls Setup
local autoBtn = createBtn("AUTO", 1, function()
    isAuto = not isAuto
    autoBtn.TextColor3 = isAuto and Color3.fromRGB(0, 255, 204) or Color3.fromRGB(220, 220, 220)
    if isAuto and not isTyping then advance() end
end)

local skipBtn = createBtn("SKIP", 2, function()
    isSkip = not isSkip
    skipBtn.TextColor3 = isSkip and Color3.fromRGB(255, 42, 109) or Color3.fromRGB(220, 220, 220)
    if isSkip then advance() end
end)

createBtn("NEXT ▶", 3, function()
    advance()
end)

-- 12. Input Listeners
dialogueContainer.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        advance()
    end
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.Return then
        advance()
    elseif input.KeyCode == Enum.KeyCode.A then
        isAuto = not isAuto
        autoBtn.TextColor3 = isAuto and Color3.fromRGB(0, 255, 204) or Color3.fromRGB(220, 220, 220)
        if isAuto and not isTyping then advance() end
    elseif input.KeyCode == Enum.KeyCode.S then
        isSkip = not isSkip
        skipBtn.TextColor3 = isSkip and Color3.fromRGB(255, 42, 109) or Color3.fromRGB(220, 220, 220)
        if isSkip then advance() end
    end
end)

-- Start playing
task.spawn(function()
    task.wait(0.2)
    showStep(1)
end)

print("[DanganronpaClient] Engine active! Visual novel running.")
]]></ProtectedString>
